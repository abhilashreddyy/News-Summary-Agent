{
    "manifest_version": 3,
    "name": "Tab Digest Agent",
    "version": "0.1.0",
    "description": "Agentic LLM that scrapes current tab, summarizes + tags, and shows a neat digest.",
    "action": { "default_popup": "popup.html", "default_icon": "icon128.png" },
    "permissions": ["storage", "scripting", "activeTab", "alarms", "notifications"],
    "background": { "service_worker": "background.js" },
    "icons": { "128": "icon128.png" }
  }
  